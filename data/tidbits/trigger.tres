[gd_resource type="Resource" script_class="TidbitType" format=3]

[ext_resource type="Script" path="res://scripts/machines/tidbits/trigger_tidbit.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"trigger"
display_name = "Trigger"
description = "Sends a signal out its port when you press its key while holding the machine or hovering over it. R switches the key between Q, E and Space."
color = Color(0.78, 0.22, 0.2, 1)
ports = Array[Vector2]([Vector2(0.85, 0.5)])
settings = PackedStringArray("Q", "E", "Space")
