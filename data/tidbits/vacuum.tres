[gd_resource type="Resource" script_class="TidbitType" format=3]

[ext_resource type="Script" path="res://scripts/machines/tidbits/vacuum_tidbit.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"vacuum"
display_name = "Vacuum"
description = "While its port gets a signal, it sucks the way it faces: pulling things toward it (and itself toward them), gripping what it's flush against, and swallowing loose single blocks and machines. With a tidbit in the way it sucks out that tidbit's contents instead. It pushes what it holds out of its valve (blue) into whatever is piped to it."
color = Color(0.3, 0.55, 0.62, 1)
ports = Array[Vector2]([Vector2(0.12, 0.5)])
valves = Array[Vector2]([Vector2(0.5, 0.88)])
storage = 24
