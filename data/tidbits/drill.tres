[gd_resource type="Resource" script_class="TidbitType" format=3]

[ext_resource type="Script" path="res://scripts/machines/tidbits/drill_tidbit.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"drill"
display_name = "Drill"
description = "While its port gets a signal, it grinds whatever is just past its tip: blocks break loose as single blocks, plant parts are cut off. Harder blocks and thicker wood take longer. The bit needs a clear path to the edge of the grid."
color = Color(0.62, 0.62, 0.66, 1)
ports = Array[Vector2]([Vector2(0.12, 0.5)])
