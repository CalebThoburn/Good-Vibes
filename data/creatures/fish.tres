blood_capacity = 0.03
upkeep = 0.0001
bleeding = 0.02

[resource]
script = ExtResource("1_species")
id = &"fish"
display_name = "Fish"
body_plan = Array[ExtResource("8_part")]([SubResource("body"), SubResource("head"), SubResource("fin")])
brain = ExtResource("20_mind")
actions = Array[ExtResource("21_action")]([SubResource("act_walk"), SubResource("act_bite"), SubResource("act_call"), SubResource("act_sleep"), SubResource("act_flee"), SubResource("act_roam")])
