food_item = &"water"
capacity = 0.5
digest_rate = 0.02
blood_per_food = 1.0
dung_per_food = 0.0
bile_capacity = 3.0

[sub_resource type="Resource" id="head"]
script = ExtResource("4_head")
name = &"head"
parent_name = &"body"
socket = Vector2(1, 0)
color = Color(0.5, 0.57, 0.65, 1)
size_variation = 0.0
neck_length = 0.5
neck_width = 0.0
