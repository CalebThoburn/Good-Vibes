[gd_resource type="Resource" script_class="CreatureSpecies" format=3]

[ext_resource type="Script" path="res://scripts/creatures/creature_species.gd" id="1_species"]
[ext_resource type="Script" path="res://scripts/creatures/parts/head_part.gd" id="4_head"]
[ext_resource type="Script" path="res://scripts/creatures/parts/wing_part.gd" id="5_wing"]
[ext_resource type="Script" path="res://scripts/creatures/parts/stomach_part.gd" id="6_stomach"]
[ext_resource type="Script" path="res://scripts/creatures/body_part.gd" id="8_part"]

[ext_resource type="Script" path="res://scripts/creatures/mind/mind.gd" id="20_mind"]
[ext_resource type="Script" path="res://scripts/creatures/actions/creature_action.gd" id="21_action"]
[ext_resource type="Script" path="res://scripts/creatures/actions/walk_to_action.gd" id="22_walk"]
[ext_resource type="Script" path="res://scripts/creatures/actions/bite_action.gd" id="23_bite"]
[ext_resource type="Script" path="res://scripts/creatures/actions/call_action.gd" id="24_call"]
[ext_resource type="Script" path="res://scripts/creatures/actions/sleep_action.gd" id="25_sleep"]
[ext_resource type="Script" path="res://scripts/creatures/actions/flee_action.gd" id="26_flee"]
[ext_resource type="Script" path="res://scripts/creatures/actions/roam_action.gd" id="27_roam"]

[sub_resource type="Resource" id="act_walk"]
script = ExtResource("22_walk")
id = &"walk_to"
verb = "swimming to"
targets = Array[StringName]([&"plant", &"block", &"creature", &"player", &"machine", &"item", &"liquid"])

[sub_resource type="Resource" id="act_bite"]
script = ExtResource("23_bite")
id = &"bite"
verb = "biting"
targets = Array[StringName]([&"plant", &"item", &"creature", &"player", &"block", &"liquid"])

[sub_resource type="Resource" id="act_call"]
script = ExtResource("24_call")
id = &"call"
verb = "blowing bubbles"
max_time = 3.0

[sub_resource type="Resource" id="act_sleep"]
script = ExtResource("25_sleep")
id = &"sleep"
verb = "sleeping"
max_time = 90.0

[sub_resource type="Resource" id="act_flee"]
script = ExtResource("26_flee")
id = &"flee"
verb = "running from"
targets = Array[StringName]([&"creature", &"player", &"machine"])
max_time = 8.0

[sub_resource type="Resource" id="act_roam"]
script = ExtResource("27_roam")
id = &"roam"
verb = "wandering"

[sub_resource type="Resource" id="body"]
script = ExtResource("6_stomach")
name = &"body"
color = Color(0.55, 0.62, 0.7, 1)
color_variation = 0.08
size = Vector2(7, 3)
puffs = 4
puff_radius = Vector2(0.8, 1.4)
underside_shade = 0.4
texture_noise = 0.03
toughness = 2.0
blood_capacity = 0.5
upkeep = 0.0003
bleeding = 0.05
