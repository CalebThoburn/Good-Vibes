[resource]
script = ExtResource("1_species")
id = &"sheep"
display_name = "Sheep"
body_plan = Array[ExtResource("8_part")]([SubResource("belly"), SubResource("chest"), SubResource("haunch"), SubResource("head"), SubResource("front_leg"), SubResource("hind_leg"), SubResource("tail")])
